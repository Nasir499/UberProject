# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/uber_db_local
DB_USERNAME=root
DB_PASSWORD=root

# Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Kafka Messaging
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis Cache & Geospatial
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & JWT
JWT_SECRET=default_uber_jwt_secret_key_change_in_production_min_256_bits_12345
JWT_EXPIRY=3600
COOKIE_EXPIRY=3600

# Server Ports
EUREKA_PORT=8761
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=7474
BOOKING_SERVICE_PORT=7777
LOCATION_SERVICE_PORT=7478
REVIEW_SERVICE_PORT=7475
SOCKET_SERVICE_PORT=8086
